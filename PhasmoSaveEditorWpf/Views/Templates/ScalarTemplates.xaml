<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:f="clr-namespace:PhasmoSaveEditor.ViewModels.Fields">

    <!--
      标量字段模板。每个模板是一张「字段卡」：
        左：中文名 + 原始 key + 提示
        右：编辑控件 + 还原按钮
        底：校验错误（非法时红字）
      卡片背景由 FieldCard 样式在 IsModified=true 时高亮。
    -->

    <!-- 卡片头部（中文名 / key / 提示）为各模板共用 -->
    <DataTemplate x:Key="FieldHeader" DataType="{x:Type f:FieldViewModel}">
        <StackPanel Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Display}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Key}" Style="{StaticResource HintText}"
                       FontFamily="Consolas" Margin="0,2,0,0"/>
            <TextBlock Text="{Binding Hint}" Style="{StaticResource HintText}"
                       Margin="0,3,0,0" MaxWidth="420" HorizontalAlignment="Left"
                       Visibility="{Binding Hint, Converter={StaticResource NullToCollapsed}}"/>
        </StackPanel>
    </DataTemplate>

    <!-- 整数 / 枚举 -->
    <DataTemplate x:Key="IntFieldTemplate" DataType="{x:Type f:IntFieldViewModel}">
        <Border Style="{StaticResource FieldCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center">
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldHeader}"/>
                    <TextBlock Text="{Binding ValidationError}" Foreground="{StaticResource ErrBrush}"
                               FontSize="11" Margin="0,4,0,0"
                               Visibility="{Binding ValidationError, Converter={StaticResource NullToCollapsed}}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox Width="150" Style="{StaticResource ValidatedTextBox}"
                             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="{Binding IsReadOnly}"/>
                    <Button Content="还原" Command="{Binding RevertCommand}"
                            Margin="6,0,0,0" Padding="8,4"
                            Visibility="{Binding IsModified, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- 浮点 -->
    <DataTemplate x:Key="FloatFieldTemplate" DataType="{x:Type f:FloatFieldViewModel}">
        <Border Style="{StaticResource FieldCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldHeader}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox Width="150" Style="{StaticResource ValidatedTextBox}"
                             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="还原" Command="{Binding RevertCommand}"
                            Margin="6,0,0,0" Padding="8,4"
                            Visibility="{Binding IsModified, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- 布尔 -->
    <DataTemplate x:Key="BoolFieldTemplate" DataType="{x:Type f:BoolFieldViewModel}">
        <Border Style="{StaticResource FieldCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldHeader}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox IsChecked="{Binding Value}" Content="启用" Margin="0,0,4,0"/>
                    <Button Content="还原" Command="{Binding RevertCommand}"
                            Padding="8,4"
                            Visibility="{Binding IsModified, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- 字符串 -->
    <DataTemplate x:Key="StringFieldTemplate" DataType="{x:Type f:StringFieldViewModel}">
        <Border Style="{StaticResource FieldCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldHeader}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox Width="220" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="还原" Command="{Binding RevertCommand}"
                            Margin="6,0,0,0" Padding="8,4"
                            Visibility="{Binding IsModified, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- 原始块兜底编辑器：多行文本 + 括号配平校验 -->
    <DataTemplate x:Key="RawBlockFieldTemplate" DataType="{x:Type f:RawBlockFieldViewModel}">
        <Border Style="{StaticResource FieldCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldHeader}"/>
                <StackPanel Grid.Column="1">
                    <TextBox Height="96" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
                             Style="{StaticResource ValidatedTextBox}"
                             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="{Binding ValidationError}" Foreground="{StaticResource ErrBrush}"
                               FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"
                               Visibility="{Binding ValidationError, Converter={StaticResource NullToCollapsed}}"/>
                    <Button Content="还原" Command="{Binding RevertCommand}" HorizontalAlignment="Right"
                            Padding="8,3" Margin="0,4,0,0"
                            Visibility="{Binding IsModified, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

</ResourceDictionary>
