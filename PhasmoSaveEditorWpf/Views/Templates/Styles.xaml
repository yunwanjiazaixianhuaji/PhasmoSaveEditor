<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="clr-namespace:PhasmoSaveEditor.Views">

    <!-- 转换器：模板里靠 StaticResource 引用 -->
    <v:NullToCollapsedConverter x:Key="NullToCollapsed"/>
    <v:HexToBrushConverter x:Key="HexToBrush"/>
    <v:ColorComponentConverter x:Key="ColorComp"/>
    <v:InverseBoolConverter x:Key="InvBool"/>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <!-- 配色：偏暗的工具风，长时间盯着改字段不刺眼 -->
    <SolidColorBrush x:Key="BgBrush" Color="#1E1F24"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#26272E"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#3A3B44"/>
    <SolidColorBrush x:Key="FgBrush" Color="#E4E4E8"/>
    <SolidColorBrush x:Key="DimBrush" Color="#9A9BA5"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#5AC8A8"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#E8A33D"/>
    <SolidColorBrush x:Key="ErrBrush" Color="#E06C5A"/>
    <SolidColorBrush x:Key="ModifiedBrush" Color="#3A4A44"/>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
    </Style>

    <Style x:Key="HintText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
                <Setter Property="Opacity" Value="0.6"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Foreground" Value="#10221C"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="#1A1B20"/>
        <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="5,3"/>
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- 校验失败时红框 -->
    <Style x:Key="ValidatedTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsValid}" Value="False">
                <Setter Property="BorderBrush" Value="{StaticResource ErrBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="#1A1B20"/>
        <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="#1A1B20"/>
        <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="#1A1B20"/>
        <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="RowBackground" Value="#1A1B20"/>
        <Setter Property="AlternatingRowBackground" Value="#202127"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#33445C"/>
                <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 字段行的外框：已修改时高亮背景 -->
    <Style x:Key="FieldCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsModified}" Value="True">
                <Setter Property="Background" Value="{StaticResource ModifiedBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
